    "/v1/orders": {
      "post": {
        "operationId": "createOrder",
        "description": "DISABLED by default. Server calculates INR totals and snapshots owned address. Customer-scoped key replays the same order only for identical input; changed payload returns 409. Duplicate product IDs are invalid. Does not authorize fulfillment. Release requires reservation expiry and provider acceptance.",
        "responses": {
          "202": {
            "description": "Success",
            "headers": {
              "X-Correlation-ID": {
                "description": "Server-generated diagnostic ID.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string"
                },
                "example": "no-store"
              },
              "Location": {
                "description": "Owned order status URL.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
