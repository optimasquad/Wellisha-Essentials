{
  "openapi": "3.0.3",
  "info": {
    "title": "Wellisha Commerce API",
    "version": "0.1.0",
    "description": "Implemented foundation only. Cognito access tokens (token_use=access, configured issuer/client_id); no cookie or legacy-session authentication and no extra scope enforcement yet. JSON requests limited to 16384 bytes; compressed bodies rejected. Monetary values are exact integer minor units on JVM; TypeScript clients must reject unsafe integers. Categories, carts, quotes, providers and staff operations are future contracts."
  },
  "security": [
    {
      "cognitoAccessToken": []
    }
  ],
