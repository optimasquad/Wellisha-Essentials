          "415": {
            "$ref": "#/components/responses/UnsupportedMedia"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Checkout disabled: empty body. Transient database failure: ApiError. Clients must handle both.",
            "headers": {
              "X-Correlation-ID": {
                "description": "Server-generated diagnostic ID.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
