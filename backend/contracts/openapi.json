  "components": {
    "securitySchemes": {
      "cognitoAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cognito access token from configured user pool and app client."
      }
    },
    "schemas": {
      "Customer": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AddressInput": {
        "type": "object",
        "required": [
          "name",
          "phone",
          "addressLine",
          "city",
          "state",
          "pincode"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Must contain a non-whitespace character."
          },
          "phone": {
            "type": "string",
            "pattern": "^[+0-9 ()-]{8,20}$"
          },
          "addressLine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Must contain a non-whitespace character."
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Must contain a non-whitespace character."
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Must contain a non-whitespace character."
          },
          "pincode": {
            "type": "string",
            "pattern": "^[1-9][0-9]{5}$"
          }
        },
        "additionalProperties": false
      },
      "Address": {
        "type": "object",
        "required": [
          "id",
          "name",
          "phone",
          "addressLine",
          "city",
          "state",
          "pincode",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Must contain a non-whitespace character."
          },
          "phone": {
            "type": "string",
            "pattern": "^[+0-9 ()-]{8,20}$"
          },
          "addressLine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Must contain a non-whitespace character."
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Must contain a non-whitespace character."
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Must contain a non-whitespace character."
          },
          "pincode": {
            "type": "string",
            "pattern": "^[1-9][0-9]{5}$"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "VersionedAddressInput": {
        "type": "object",
        "required": [
          "version",
          "address"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "address": {
            "$ref": "#/components/schemas/AddressInput"
          }
        },
        "additionalProperties": false
      },
      "ProductView": {
        "type": "object",
        "required": [
          "id",
          "name",
          "sku",
          "priceMinor",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "priceMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "available": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "OrderLineInput": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Must contain a non-whitespace character."
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
