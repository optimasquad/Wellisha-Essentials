rectangle" fill="#FFE86D" stroke="#A28E26" stroke-width="2" data-content="10. Ambiguous outcome&lt;br&gt;Reconcile before retry" data-text-color="#574900" data-font-family="noto_sans" data-font-size="33"/><rect id="post_eligibility" x="96" y="1472" width="488" height="224" data-shape="rectangle" fill="#B8ACFB" stroke="#8A7BE0" stroke-width="2" data-content="11. Confirm refund eligibility&lt;br&gt;Cancelled or verified return/RTO" data-text-color="#231266" data-font-family="noto_sans" data-font-size="33"/><rect id="post_refund" x="712" y="1472" width="488" height="224" data-shape="rectangle" fill="#B8ACFB" stroke="#8A7BE0" stroke-width="2" data-content="12. Refund worker / Razorpay&lt;br&gt;Deduplicated refund intent" data-text-color="#231266" data-font-family="noto_sans" data-font-size="33"/><rect id="post_outcome" x="1328" y="1472" width="488" height="224" data-shape="rectangle" fill="#B8ACFB" stroke="#8A7BE0" stroke-width="2" data-content="13. Signed refund outcome&lt;br&gt;Validate / persist / reconcile" data-text-color="#231266" data-font-family="noto_sans" data-font-size="33"/><rect id="post_status" x="1944" y="1472" width="488" height="224" data-shape="rectangle" fill="#B8ACFB" stroke="#8A7BE0" stroke-width="2" data-content="14. Customer refund status&lt;br&gt;Separate from shipment status" data-text-color="#231266" data-font-family="noto_sans" data-font-size="33"/><rect id="post_notify" x="2560" y="1472" width="488" height="224" data-shape="rectangle" fill="#B8ACFB" stroke="#8A7BE0" stroke-width="2" data-content="15. Email and SMS queues&lt;br&gt;Delivery outcomes / retries" data-text-color="#231266" data-font-family="noto_sans" data-font-size="33"/><line id="post_edge0" x1="584" y1="496" x2="712" y2="496" data-start="post_paid" data-end="post_worker" data-start-side="right" data-end-side="left" data-shape="straight" data-arrow="end" stroke="#313131" stroke-width="2"/><line id="post_edge1" x1="1200" y1="496" x2="1328" y2="496" data-start="post_worker" data-en