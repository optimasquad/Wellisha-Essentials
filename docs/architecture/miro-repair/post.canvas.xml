<svg xmlns="http://www.w3.org/2000/svg"><g id="post_fixed" data-frame="B. Post-Booking Operations" transform="translate(3520,0)"><rect data-type="frame" x="0" y="0" width="3200" height="2240" fill="#ffffff"/><textArea id="post_title" x="64" y="64" width="3072" font-family="noto_sans" font-size="67" font-weight="bold" fill="#1a1a1a">B. Post-Booking Operations</textArea><textArea id="post_note" x="64" y="184" width="3072" font-family="noto_sans" font-size="33" fill="#595959">Fulfillment, delivery tracking and controlled support actions. Cancellation is agent-only.</textArea><rect x="64" y="256" width="3072" height="416" fill="#f0f5fd" stroke="#b0b0b0" stroke-width="2"/><textArea x="96" y="288" width="3008" font-family="noto_sans" font-size="33" font-weight="bold" fill="#1a1a1a">FULFILLMENT AND TRACKING</textArea><rect x="64" y="800" width="3072" height="416" fill="#fffbed" stroke="#b0b0b0" stroke-width="2"/><textArea x="96" y="832" width="3008" font-family="noto_sans" font-size="33" font-weight="bold" fill="#1a1a1a">SUPPORT AND CANCELLATION</textArea><rect x="64" y="1344" width="3072" height="416" fill="#f0f5fd" stroke="#b0b0b0" stroke-width="2"/><textArea x="96" y="1376" width="3008" font-family="noto_sans" font-size="33" font-weight="bold" fill="#1a1a1a">ELIGIBILITY, REFUNDS AND COMMUNICATIONS</textArea><rect id="post_paid" x="96" y="384" width="488" height="224" data-shape="rectangle" fill="#9CE6FF" stroke="#2C97BB" stroke-width="2" data-content="1. OrderPaid / outbox&lt;br&gt;EventBridge / SQS" data-text-color="#1C4657" data-font-family="noto_sans" data-font-size="33"/><rect id="post_worker" x="712" y="384" width="488" height="224" data-shape="rectangle" fill="#9CE6FF" stroke="#2C97BB" stroke-width="2" data-content="2. Fulfillment worker&lt;br&gt;Stable merchant request ID" data-text-color="#1C4657" data-font-family="noto_sans" data-font-size="33"/><rect id="post_provider" x="1328" y="384" width="488" height="224" data-shape="rectangle" fill="#9CE6FF" stroke="#2C9