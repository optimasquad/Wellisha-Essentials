" value="1. Create support case; no order mutation" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="211" y="221" width="538" height="44" as="geometry"/></mxCell><mxCell id="steptext1" value="2. Read assigned case; verify customer/order" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="297" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext2" value="3. Agent cancellation: case + reason + key" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="373" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext3" value="4. Check agent permission; lock; record intent" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="771" y="449" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext4" value="5. 202 pending cancellation" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="525" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext5" value="6. Cancel / reconcile in-flight submission" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="1051" y="601" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext6" value="7. Accepted, rejected or pending" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=