mxCell id="vtohandoff" style="html=0;endArrow=block;endFill=1;strokeColor=#526779;strokeWidth=1.6;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="480" as="sourcePoint"/><mxPoint x="340" y="480" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="09-post-booking" name="09  Post-Booking Operations"><mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="post0" value="OrderPaid event&#10;EventBridge + SQS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F3F7;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="280" height="100" as="geometry"/></mxCell><mxCell id="post1" value="Fulfillment worker&#10;Idempotent provider adapter" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F3F7;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="400" y="190" width="280" height="100" as="geometry"/></mxCell><mxCell id="post2" value="Amazon Shipping&#10;Wellisha packs; Amazon delivers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#FCE8E6;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="740" y="190" width="280" height="100" as="geometry"/></mxCell><mxCell id="post3" value="Tracking inbox + worker&#10;Normalize provider updates" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F3F7;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="1080" y="190" width="280" height="100" as="geometry"/></mxCell><mxCell id="post4" value="Web / Android / iOS&#10;Timeline, ETA, last update" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E8F0FE;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="1420" y="190" width="280" height="100" as="geometry"/></mxCell><mxCell id="cancel0" value="Customer contacts support&#10;Case only; no cancellation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E8F0FE;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="280" height="115" as="geometry"/></mxCell><mxCell id="cancel1" value="Authorized support agent&#10;MFA, role, reason, case ID" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F4EA;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="280" height="115" as="geometry"/></mxCell><mxCell id="cancel2" value="Cancellation worker&#10;Record intent; serialize&#10;with shipment submission" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F4EA;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="740" y="450" width="280" height="115" as="geometry"/></mxCell><mxCell id="cancel3" value="Provider cancellation&#10;Accepted / rejected / pending" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#FCE8E6;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="1080" y="450" width="280" height="115" as="geometry"/></mxCell><mxCell id="cancel4" value="Refund worker + Razorpay&#10;Only after eligible outcome&#10;Reconcile before completion" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F4EA;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="1420" y="450" width="280" height="115" as="geometry"/></mxCell><mxCell id="notifications" value="Asynchronous customer updates&#10;Business outbox -&gt; EventBridge -&gt; separate email/SMS queues -&gt; SES / AWS End User Messaging&#10;Order, shipment, support, agent cancellation and refund updates; provider acceptance is not final delivery." style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F3F7;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="1640" height="110" as="geometry"/></mxCell><mxCell id="controls" value="Agent-only control boundary&#10;Customer cancellation calls are forbidden by the API. Manual provider-portal actions require an audited case and reconciliation.&#10;Separate order, shipment, cancellation and refund states; split shipments and partial refunds remain explicit." style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#F2F4F7;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="60" y="865" width="1640" height="110" as="geometry"/></mxCell><mxCell id="title" value="09  Post-Booking Operations" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1720" height="42" as="geometry"/></mxCell><mxCell id="subtitle" value="Miro section B | Fulfillment, delivery tracking, support and controlled cancellation" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1720" height="45" as="geometry"/></mxCell><mxCell id="trackingapi" value="Tracking is served by the owner-authorized API from durable shipment state; webhooks and polling keep it current." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="60" y="325" width="1640" height="55" as="geometry"/></mxCell><mxCell id="conditional" value="Provider rejection or dispatched shipment -&gt; support explains the outcome / eligible return policy. No automatic cancellation from a customer case." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="1640" height="60" as="geometry"/></mxCell><mxCell id="postreview" value="Operations: retry budgets, DLQs, provider reconciliation, staff access review, support SLA and refund approval thresholds." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="1640" height="55" as="geometry"/></mxCell><mxCell id="postarrow0" style="html=0;endArrow=block;endFill=1;strokeColor=#526779;strokeWidth=1.6;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="240" as="sourcePoint"/><mxPoint x="400" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="postarrow1" style="html=0;endArrow=block;endFill=1;strokeColor=#526779;strokeWidth=1.6;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="240" as="sourcePoint"/><mxPoint x="740" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="postarrow2" style="html=0;endArrow=block;endFill=1;strokeColor=#526779;strokeWidth=1.6;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="240" as="sourcePoint"/><mxPoint x="1080" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="postarrow3" style="html=0;endArrow=block;endFill=1;strokeColor=#526779;strokeWidth=1.6;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="240" as="sourcePoint"/><mxPoint x="1420" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cancelarrow0" style="html=0;endArrow=block;endFill=1;strokeColor=#526779;stroke