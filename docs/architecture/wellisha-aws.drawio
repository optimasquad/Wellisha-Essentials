"><mxPoint x="1600" y="954" as="sourcePoint"/><mxPoint x="760" y="954" as="targetPoint"/></mxGeometry></mxCell><mxCell id="step10" style="html=0;endArrow=block;endFill=1;strokeColor=#526779;strokeWidth=1.6;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1030" as="sourcePoint"/><mxPoint x="1040" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="step11" style="html=0;endArrow=block;endFill=1;strokeColor=#526779;strokeWidth=1.6;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="1106" as="sourcePoint"/><mxPoint x="760" y="1106" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="06-notifications" name="06  Asynchronous Email and SMS"><mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1302" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="actor0" value="Commerce transaction" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E8F0FE;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="72" y="140" width="256" height="72" as="geometry"/></mxCell><mxCell id="actor1" value="DB outbox" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F4EA;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="352" y="140" width="256" height="72" as="geometry"/></mxCell><mxCell id="actor2" value="Relay + EventBridge" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F4EA;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="632" y="140" width="256" height="72" as="geometry"/></mxCell><mxCell id="actor3" value="Email / SMS queues&#10;+ DLQs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F4EA;strokeColor=#8291A0;fontColor