" height="105" as="geometry"/></mxCell><mxCell id="redis" value="ElastiCache for Valkey&#10;Versioned catalog read cache&#10;Checkout revalidates in DB" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#FFF2CC;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="600" y="780" width="450" height="105" as="geometry"/></mxCell><mxCell id="queues" value="EventBridge -&gt; dedicated SQS queues&#10;Each queue has a DLQ&#10;Idempotent workers + reconciliation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F3F7;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="1220" y="780" width="480" height="105" as="geometry"/></mxCell><mxCell id="s3" value="S3&#10;Images, imports, invoices&#10;Restricted buckets / prefixes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#FFF2CC;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="100" y="970" width="330" height="95" as="geometry"/></mxCell><mxCell id="schedule" value="EventBridge Scheduler&#10;Imports, expiry, reconciliation&#10;S3 events also enqueue imports" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F3F7;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="470" y="970" width="360" height="95" as="geometry"/></mxCell><mxCell id="payment" value="Razorpay&#10;Hosted checkout&#10;Signed payment/refund webhooks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#FCE8E6;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="880" y="970" width="370" height="95" as="geometry"/></mxCell><mxCell id="fulfill" value="Fulfillment adapter&#10;Amazon Shipping (store pickup)&#10;Create, track, cancel, return" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=A