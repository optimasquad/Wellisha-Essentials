mily=Arial;fontSize=15;fillColor=#E6F4EA;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="632" y="140" width="256" height="72" as="geometry"/></mxCell><mxCell id="actor3" value="Image processing /&#10;MediaConvert" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F4EA;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="912" y="140" width="256" height="72" as="geometry"/></mxCell><mxCell id="actor4" value="Catalog media records" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#E6F4EA;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="1192" y="140" width="256" height="72" as="geometry"/></mxCell><mxCell id="actor5" value="CloudFront / clients" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#FCE8E6;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="1472" y="140" width="256" height="72" as="geometry"/></mxCell><mxCell id="notes" value="Generated packaging is a mockup until approved. No processing loop: source and derivative prefixes differ.&#10;Only public product media is CDN-readable; invoices, imports and customer data remain private." style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;fillColor=#F2F4F7;strokeColor=#8291A0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="60" y="1121" width="1680" height="72" as="geometry"/></mxCell><mxCell id="title" value="10  Product Media Publication" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1720" height="42" as="geometry"/></mxCell><mxCell id="subtitle" value="Approved product identity across web, Android and iOS | Originals preserved; delivery assets versioned" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1720" height="45" as="geometry"/></mxCell><mxCell id="steptext0" value="1. Upload original / generated review master" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="211" y="221" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext1" value="2. Object-created event + asset version" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="297" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext2" value="3. Validate type, size, metadata; deduplicate" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="634" y="378" width="252" height="40" as="geometry"/></mxCell><mxCell id="steptext3" value="4. Create bounded image/video derivatives" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="771" y="449" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext4" value="5. Write derivatives to separate output prefix" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="525" width="538" height="44" as="geometry"/></mxCell><mxCell id="steptext5" value="6. Completion / failure event" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent=