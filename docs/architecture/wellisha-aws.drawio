></mxCell><mxCell id="subtitle" value="Customers pay on Wellisha | Captured payment evidence drives order confirmation | External outcomes may be pending" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1720" height="45" as="geometry"/></mxCell><mxCell id="steptext0" value="1. Create order: quote + idempotency key" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="211" y="221" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext1" value="2. Reprice; reserve stock; persist pending order" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="297" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext2" value="3. Create payment order outside DB transaction" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="373" width="538" height="44" as="geometry"/></mxCell><mxCell id="steptext3" value="4. Provider order ID or unknown outcome" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="449" width="538" height="44" as="geometry"/></mxCell><mxCell id="steptext4" value="5. Persist payment mapping; unknown -&gt; reconcile" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="525" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext5" value="6. Checkout details or 202 pending" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="211" y="601" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext6" value="7. Customer completes payment" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="211" y="677" width="818" height="44" as="geometry"/></mxCell><mxCell id="steptext7" value="8. Signed captured-payment webhook" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="753" width="538" height="44" as="geometry"/></mxCell><mxCell id="steptext8" value="9. Verify signature; persist unique inbox" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="829" width="258" height="44" as="geometry"/></mxCell><mxCell id="steptext9" value="10. Acknowledge durable receipt" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="491" y="905" width="538" height="44" as="geometry"/></mxCell><mxCell id="steptext10" value="11. Validate payment binding; paid + outbox transaction" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex="1" parent="1"><mxGeometry x="771" y="981" width="538" height="44" as="geometry"/></mxCell><mxCell id="steptext11" value="12. Book shipment after packed-ready" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202B37;spacing=9;" vertex