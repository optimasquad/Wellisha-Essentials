<svg viewBox="0 0 3840 2160" xmlns="http://www.w3.org/2000/svg">
<g id="m3458764685971754088" data-miro-id="3458764685971754088" transform="translate(11520,7680)" data-frame="19. Amazon Shipping - Store Pickup Integration">
<rect data-type="frame" x="0" y="0" width="3200" height="2400" fill="#ffffff" data-title="19. Amazon Shipping - Store Pickup Integration" />
<textArea id="m3458764685971754094" data-miro-id="3458764685971754094" x="64" y="65" width="3072" height="94" fill="#231266" font-family="open_sans" font-size="67" text-align="left" font-weight="bold">19. Amazon Shipping - Store Pickup Integration</textArea>
<textArea id="m3458764685971754095" data-miro-id="3458764685971754095" x="64" y="220.5" width="3072" height="47" fill="#231266" font-family="open_sans" font-size="33" text-align="left">Inventory and packing stay at Wellisha. Customer payment and Amazon shipping charges are separate.</textArea>
<rect id="m3458764685971754096" data-miro-id="3458764685971754096" x="64" y="352" width="688" height="360" data-content="1. Verified payment&lt;br /&gt;Store pick/pack task&lt;br /&gt;No Amazon booking yet" fill="#9ce6ff" data-text-color="#1c4657" data-font-size="33" stroke="#2c97bb" />
<rect id="m3458764685971754097" data-miro-id="3458764685971754097" x="848" y="352" width="688" height="360" data-content="2. Wellisha store&lt;br /&gt;Pack / weigh / measure&lt;br /&gt;Staff marks packed-ready" fill="#9ce6ff" data-text-color="#1c4657" data-font-size="33" stroke="#2c97bb" />
<rect id="m3458764685971754099" data-miro-id="3458764685971754099" x="1632" y="352" width="688" height="360" data-content="3. Shipping worker&lt;br /&gt;Get eligible rates&lt;br /&gt;Purchase shipment / label" fill="#b8acfb" data-text-color="#231266" data-font-size="33" stroke="#8a7be0" />
<rect id="m3458764685971754100" data-miro-id="3458764685971754100" x="2416" y="352" width="688" height="360" data-content="4. Staff prints label&lt;br /&gt;Parcel ready for pickup&lt;br /&gt;Amazon collects / delivers" fill="#b8acfb" data-text-color="#231266" data-font-size="33" stroke="#8a7be0" />
<rect id="m3458764685971754101" data-miro-id="3458764685971754101" x="64" y="896" width="1488" height="480" fill="#ffe86d" data-text-color="#574900" data-font-family="open_sans" data-font-size="14" stroke="#a28e26" />
<textArea id="m3458764685971754102" data-miro-id="3458764685971754102" x="96" y="936.5" width="1424" height="47" fill="#574900" font-family="open_sans" font-size="33" text-align="left" font-weight="bold">Amazon Shipping API v2</textArea>
<textArea id="m3458764685971754103" data-miro-id="3458764685971754103" x="96" y="1114.5" width="1424" height="139" fill="#574900" font-family="open_sans" font-size="33" text-align="left">India business header: AmazonShipping_IN. Wellisha orders use EXTERNAL channel. getRates -&gt; required extra inputs -&gt; purchaseShipment. Save shipment, carrier and tracking IDs; retrieve documents.</textArea>
<rect id="m3458764685971754104" data-miro-id="3458764685971754104" x="1648" y="896" width="1488" height="480" fill="#b8acfb" data-text-color="#231266" data-font-family="open_sans" data-font-size="14" stroke="#8a7be0" />
<textArea id="m3458764685971754105" data-miro-id="3458764685971754105" x="1680" y="936.5" width="1424" height="47" fill="#231266" font-family="open_sans" font-size="33" text-align="left" font-weight="bold">Reliable background operations</textArea>
<textArea id="m3458764685971754107" data-miro-id="3458764685971754107" x="1680" y="1114.5" width="1424" height="139" fill="#231266" font-family="open_sans" font-size="33" text-align="left">Short DB commits + outbox -&gt; SQS -&gt; Shipping worker. Stable package reference and one active purchase attempt. Timeout after purchase means UNKNOWN: reconcile or manual review; never blindly buy twice.</textArea>
<rect id="m3458764685971754108" data-miro-id="3458764685971754108" x="64" y="1472" width="1488" height="480" fill="#9ce6ff" data-text-color="#1c4657" data-font-family="open_sans" data-font-size="14" stroke="#2c97bb" />
<textArea id="m3458764685971754109" data-miro-id="3458764685971754109" x="96" y="1512.5" width="1424" height="47" fill="#1c4657" font-family="open_sans" font-size="33" text-align="left" font-weight="bold">Tracking and customer view</textArea>
<textArea id="m3458764685971754110" data-miro-id="3458764685971754110" x="96" y="1690.5" width="1424" height="139" fill="#1c4657" font-family="open_sans" font-size="33" text-align="left">Manual onboarding for tracking push notifications; authenticated HTTPS -&gt; durable inbox -&gt; worker. getTracking polling/reconciliation fallback. Created label is not pickup. Normalize picked up, transit, delivered and RTO.</textArea>
<rect id="m3458764685971754111" data-miro-id="3458764685971754111" x="1648" y="1472" width="1488" height="480" fill="#ffe86d" data-text-color="#574900" data-font-family="open_sans" data-font-size="14" stroke="#a28e26" />
<textArea id="m3458764685971754112" data-miro-id="3458764685971754112" x="1680" y="1512.5" width="1424" height="47" fill="#574900" font-family="open_sans" font-size="33" text-align="left" font-weight="bold">Security and launch gates</textArea>
<textArea id="m3458764685971754113" data-miro-id="3458764685971754113" x="1680" y="1690.5" width="1424" height="139" fill="#574900" font-family="open_sans" font-size="33" text-align="left">LWA app secret / refresh token in Secrets Manager. Labels in private encrypted S3; staff-only short-lived access. Confirm registered store, pickup coverage/cutoffs, API role, label approval and cancellation/returns contract.</textArea>
<textArea id="m3458764685971754114" data-miro-id="3458764685971754114" x="64" y="2145.5" width="3072" height="93" fill="#231266" font-family="open_sans" font-size="33" text-align="left">Tests: packed-ready gate; expired rate refresh; label reprint without repurchase; duplicate/late tracking; pickup failure; purchase timeout; staff-only cancellation; no refund based only on booking or label.</textArea>
</g>
